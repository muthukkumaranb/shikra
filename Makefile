.PHONY: setup data split rul replay params sim summary heatmap bias shock figures deck-figures explain readme cards test lint reproduce reproduce-sim reproduce-sim-quick ingest app verify

PY     ?= python
PIP    ?= pip
PYTEST ?= pytest
RUFF   ?= ruff

# ── Environment ──────────────────────────────────────────────────────────────
setup:
	@$(PY) --version
	$(PY) -m venv .venv
	$(PIP) install --upgrade pip
	$(PIP) install -r requirements.txt
	@echo "Virtual environment ready."

# ── Data download & verification ─────────────────────────────────────────────
data:
	$(PY) scripts/download_cmapss.py

# ── Frozen unit split ────────────────────────────────────────────────────────
split:
	$(PY) -m shikra.data.split

# ── RUL model training + evaluation ──────────────────────────────────────────
rul:
	$(PY) -m shikra.rul.evaluate

# ── Replay RUL table ─────────────────────────────────────────────────────────
replay:
	$(PY) -m shikra.rul.replay

# ── Policy parameters ────────────────────────────────────────────────────────
params:
	$(PY) -m shikra.rul.policy_params

# ── Fleet simulation ─────────────────────────────────────────────────────────
sim:
	$(PY) -m shikra.sim.runner

# ── Summary statistics and gates ─────────────────────────────────────────────
summary:
	$(PY) scripts/summary.py

# ── Heatmap (lever map) ──────────────────────────────────────────────────────
heatmap:
	$(PY) scripts/heatmap.py

# ── Bias sweep ───────────────────────────────────────────────────────────────
bias:
	$(PY) scripts/bias.py

# ── Supply shock ─────────────────────────────────────────────────────────────
shock:
	$(PY) scripts/supply_shock.py

# ── Figures ──────────────────────────────────────────────────────────────────
figures:
	$(PY) scripts/figures.py

deck-figures:
	$(PY) scripts/deck_figures.py

# ── Per-engine q10 explanations (needs data/raw: make data) ──────────────────
explain:
	$(PY) scripts/explain_contrib.py

# ── README table ─────────────────────────────────────────────────────────────
readme:
	$(PY) scripts/readme_table.py

# ── Model card ───────────────────────────────────────────────────────────────
cards:
	$(PY) scripts/cards.py

# ── Ingestion & DQ checks ────────────────────────────────────────────────────
ingest:
	$(PY) scripts/ingest.py

# ── Tests ────────────────────────────────────────────────────────────────────
test:
	$(PY) -m pytest -q -m "not data"

# ── Lint ─────────────────────────────────────────────────────────────────────
lint:
	$(PY) -m ruff check .

# ── Full reproduction (after data) ───────────────────────────────────────────
reproduce: split rul replay params sim summary heatmap bias shock figures readme
	@echo "Full pipeline complete. Results are in results/"

# ── Simulation reproduction (no raw data needed) ─────────────────────────────
reproduce-sim: sim summary heatmap bias shock figures readme
	@echo "Simulation reproduction complete. Results are in results/"

# ── Quick simulation reproduction (CI mode) ──────────────────────────────────
reproduce-sim-quick: sim summary bias
	@echo "Quick simulation reproduction complete."

# ── Dashboard application ────────────────────────────────────────────────────
app:
	$(PY) -m streamlit run app/Home.py

# ── One-line reproducibility verification ─────────────────────────────────────
# Note: PNGs are excluded because platform-specific font/matplotlib rasterization
# can introduce minor byte-level differences across OS platforms.
verify:
	$(PY) scripts/check_reproduce.py
	$(PY) -m pytest -q -m "not data"
	$(MAKE) reproduce-sim PY=$(PY)
	$(PY) scripts/check_reproduce.py
	git diff --exit-code --stat -- results/ ':!results/*.png'
	@echo "VERIFIED: tests pass, every committed result regenerated byte-identical."
