// SHIKRA end-to-end workflow (deck / video image). Render:
//   dot -Tpng -Gdpi=200 SIH26249_Workflow.dot -o SIH26249_Workflow.png
digraph SHIKRA {
  graph [rankdir=LR, splines=spline, nodesep=0.35, ranksep=0.7, pad=0.35, bgcolor="white",
         fontname="Inter", fontsize=22, labelloc=t,
         label=<<B>SHIKRA: end-to-end workflow</B><BR/><FONT POINT-SIZE="14" COLOR="#555555">Predict the snag, place the spare, fly the sortie. Advisory · air-gapped · evaluated on NASA C-MAPSS + a synthetic 54-aircraft wing</FONT><BR/><FONT POINT-SIZE="13" COLOR="#2d3748"><B>Proof:</B> every number regenerates with <FONT FACE="DejaVu Sans Mono">make reproduce-sim</FONT> · 30 seeds, paired bootstrap 95% CIs · frozen unit split · CI on every commit</FONT>>];
  node  [shape=box, style="rounded,filled", fontname="Inter", fontsize=13, penwidth=1.4, margin="0.18,0.10"];
  edge  [color="#4a5568", penwidth=1.6, arrowsize=0.8];

  // ── 1. Sources ───────────────────────────────────────────────
  subgraph cluster_src {
    label=<<B>1 · FOUR SOURCES</B>>; fontsize=14; style="rounded,dashed"; color="#9aa5b1"; fontcolor="#2d3748";
    hums  [label=<<B>HUMS</B><BR/><FONT POINT-SIZE="11">engine health data</FONT>>, fillcolor="#e6f0fa", color="#2b6cb0"];
    emms  [label=<<B>e-MMS</B><BR/><FONT POINT-SIZE="11">technical records</FONT>>, fillcolor="#e6f0fa", color="#2b6cb0"];
    immols[label=<<B>IMMOLS</B><BR/><FONT POINT-SIZE="11">spares stock</FONT>>, fillcolor="#e6f0fa", color="#2b6cb0"];
    brd   [label=<<B>BRD / HAL</B><BR/><FONT POINT-SIZE="11">repair pipeline</FONT>>, fillcolor="#e6f0fa", color="#2b6cb0"];
  }

  // ── 2. Ingest ────────────────────────────────────────────────
  ingest [label=<<B>2 · INGEST</B><BR/><FONT POINT-SIZE="11">one model per tail &amp; serial<BR/>(SQLite)<BR/>bad rows → quarantine</FONT>>, fillcolor="#edf7ed", color="#2f855a"];

  // ── 3. Predict ───────────────────────────────────────────────
  predict [label=<<B>3 · PREDICT</B><BR/><FONT POINT-SIZE="11">engine remaining life<BR/>LightGBM quantiles<BR/>+ conformal 80% band<BR/>plan on the pessimistic edge (q10)</FONT>>, fillcolor="#fff4e5", color="#c05621"];

  // ── 4. Simulate ──────────────────────────────────────────────
  sim [label=<<B>4 · SIMULATE</B><BR/><FONT POINT-SIZE="11">synthetic 54-aircraft wing<BR/>engines fly held-out NASA trajectories<BR/>reactive · fixed-interval · SHIKRA · perfect</FONT>>, fillcolor="#f3eefb", color="#6b46c1"];

  // ── 5. Decide ────────────────────────────────────────────────
  subgraph cluster_dec {
    label=<<B>5 · DECIDE</B>>; fontsize=14; style="rounded,dashed"; color="#9aa5b1"; fontcolor="#2d3748";
    d1 [label=<<B>Which engine to pull</B><BR/><FONT POINT-SIZE="11">removal when q10 ≤ R*</FONT>>, fillcolor="#fdecec", color="#c53030"];
    d2 [label=<<B>Where the spare goes</B><BR/><FONT POINT-SIZE="11">VARI-METRIC, fixed budget</FONT>>, fillcolor="#fdecec", color="#c53030"];
    d3 [label=<<B>Which lever pays</B><BR/><FONT POINT-SIZE="11">lever map: prediction × pipeline</FONT>>, fillcolor="#fdecec", color="#c53030"];
    d4 [label=<<B>What to make in India first</B><BR/><FONT POINT-SIZE="11">180-day supply-halt ranking</FONT>>, fillcolor="#fdecec", color="#c53030"];
  }

  // ── 6. Act ───────────────────────────────────────────────────
  app [label=<<B>6 · OFFLINE APP</B><BR/><FONT POINT-SIZE="11">Commander · Engineering Officer<BR/>Logistics · Technician</FONT>>, fillcolor="#e8f4f8", color="#2c7a7b"];
  signoff [label=<<B>OFFICER SIGNS OFF</B><BR/><FONT POINT-SIZE="11">approve / defer<BR/>append-only audit log</FONT>>, shape=box, style="rounded,filled,bold", fillcolor="#1a365d", fontcolor="white", color="#1a365d"];

  hums -> ingest; emms -> ingest; immols -> ingest; brd -> ingest;
  ingest -> predict -> sim;
  sim -> d1; sim -> d2; sim -> d3; sim -> d4;
  d1 -> app; d2 -> app; d3 -> app; d4 -> app;
  app -> signoff;

}
